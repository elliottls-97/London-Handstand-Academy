{
  "appId": "com.londonhandstandacademy.app",
  "appName": "Handstand",
  "webDir": "www",
  "appendUserAgent": "LHAiOS",
  "server": {
    "url": "https://londonhandstandacademy.com/lha-app.html",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "londonhandstandacademy.com",
      "www.londonhandstandacademy.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true,
    "backgroundColor": "#0a2530"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 10000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#0a2530",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}